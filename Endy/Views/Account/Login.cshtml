@model Endy.Models.LoginInput
@{ Layout = null; }<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Sign in - DP World Access</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css"/></head><body class="login-page"><div class="login-card"><div class="brand login-brand"><div class="brand-mark">DP</div><div><strong>DP World</strong><small>Algeria Access</small></div></div><h1>Welcome back</h1><p class="muted">Sign in to manage access requests securely.</p><form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><label asp-for="UserName">Username</label><input asp-for="UserName" class="form-control" placeholder="Enter your username" autocomplete="username" required/><label asp-for="Password">Password</label><input asp-for="Password" class="form-control" placeholder="Enter your password" autocomplete="current-password" required/><div class="form-check mt-2"><input asp-for="RememberMe" class="form-check-input"/><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><button class="btn btn-primary w-100 mt-3">Sign in <span>→</span></button></form></div></body></html>