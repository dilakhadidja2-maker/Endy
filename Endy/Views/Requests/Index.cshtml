@model IReadOnlyList<Endy.Models.AccessRequest>
@{ ViewData["Title"] = "Access Requests"; }
<div class="section-heading"><div><h2>Access requests</h2><p class="muted">@(ViewBag.IsAdmin == true ? "Review and track requests across departments." : "Track the access requests you submitted." )</p></div>@if (ViewBag.CanCreateRequest == true) { <a class="btn btn-primary" asp-action="Create">＋ New request</a> }</div>
<form class="filter-bar" method="get"><input name="search" value="@ViewBag.Search" placeholder="Search name or registration number..."/><select name="status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<Endy.Models.RequestStatus>()) { <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</option> }</select><label>From <input type="date" name="from" value="@ViewBag.From"/></label><label>To <input type="date" name="to" value="@ViewBag.To"/></label>@if (ViewBag.IsAdmin == true || ViewBag.IsSuperAdmin == true) { <select name="departmentId"><option value="">All departments</option>@foreach (var d in (IReadOnlyList<Endy.Models.Department>)ViewBag.Departments) { <option value="@d.Id" selected="@(ViewBag.DepartmentId?.ToString() == d.Id.ToString())">@d.Name</option> }</select><input name="createdBy" value="@ViewBag.CreatedBy" placeholder="Created by"/> }<button class="btn btn-outline-secondary">Filter</button></form>
<div class="table-card"><table class="table enterprise-table"><thead><tr><th>Customer</th><th>Vehicle</th><th>Company</th><th>Department</th>@if (ViewBag.IsAdmin == true) { <th>Created by</th> }<th>Request date</th><th>Status</th><th></th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="8" class="empty-state">No requests match these filters.</td></tr> }
@foreach (var r in Model) { <tr><td><strong>@r.FullName</strong><small>@r.RegistrationNumber</small></td><td>@r.VehicleType</td><td>@r.CompanyName</td><td>@r.Department.Name</td>@if (ViewBag.IsAdmin == true) { <td>@r.CreatedBy</td> }<td>@(Endy.Models.DateTimeDisplay.ToLocal(r.RequestDate).ToString("dd MMM yyyy"))</td><td><span class="badge-status status-@r.Status.ToString().ToLowerInvariant()">@r.Status.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</span></td><td><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-light">View</a></td></tr> }
</tbody></table></div>