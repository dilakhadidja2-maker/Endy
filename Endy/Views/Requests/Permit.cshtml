@model Endy.Models.AccessRequest
@{ Layout = null; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Access Permit - @Model.Id</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><style>@@page{size:A4;margin:18mm}body{font-family:Arial,sans-serif;color:#14243b}.permit{border:3px solid #14243b;padding:35px;min-height:250mm}.header{text-align:center;border-bottom:2px solid #00a7a0;padding-bottom:18px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:35px}.fields span{display:block;color:#667085;font-size:12px;text-transform:uppercase}.fields strong{font-size:17px}.signatures{display:flex;justify-content:space-between;margin-top:100px}.signatures div{width:40%;border-top:1px solid #344054;padding-top:10px}.print{margin:20px}@@media print{.print{display:none}}</style></head><body><button class="btn btn-primary print" onclick="window.print()">Print Permit</button><main class="permit"><header class="header"><h1>DP World Algeria</h1><h2>Customer Access Permit</h2><p>Permit No. @Model.Id</p></header><section class="fields"><div><span>Full Name</span><strong>@Model.FullName</strong></div><div><span>Company Name</span><strong>@Model.CompanyName</strong></div><div><span>Vehicle Type</span><strong>@Model.VehicleType</strong></div><div><span>Registration Number</span><strong>@Model.RegistrationNumber</strong></div><div><span>Visit Duration</span><strong>@Model.VisitDurationHours hours</strong></div><div><span>Department</span><strong>@Model.Department.Name</strong></div><div><span>Security Department</span><strong>@Model.SecurityDepartment</strong></div><div><span>Approval Date</span><strong>@(Model.ApprovalDate.HasValue ? Endy.Models.DateTimeDisplay.ToLocal(Model.ApprovalDate.Value).ToString("dd MMM yyyy, HH:mm") : "Unavailable")</strong></div><div><span>Permit Issue Date</span><strong>@DateTime.Now.ToString("dd MMM yyyy, HH:mm")</strong></div></section><footer class="signatures"><div>Authorized Signature</div><div>Official Stamp</div></footer></main></body></html>
