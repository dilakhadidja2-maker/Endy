@model Endy.Models.AccessRequest
@{ ViewData["Title"] = "Request Details"; }
<div class="section-heading"><div><a asp-action="Index" class="back-link">← Back to requests</a><h2>@Model.FullName</h2><p class="muted">Request #@Model.Id · Created by @Model.CreatedBy</p></div>@if (ViewBag.IsAdmin == true && Model.Status == Endy.Models.RequestStatus.Approved) { <a asp-action="Permit" asp-route-id="@Model.Id" class="btn btn-primary">Print access permit</a> }</div>
<div class="detail-grid"><div class="form-card"><div class="panel-title"><h3>Request information</h3><span class="badge-status status-@Model.Status.ToString().ToLowerInvariant()">@Model.Status.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</span></div><div class="detail-fields"><div><small>Full name</small><strong>@Model.FullName</strong></div><div><small>Company</small><strong>@Model.CompanyName</strong></div><div><small>Vehicle</small><strong>@Model.VehicleType · @Model.RegistrationNumber</strong></div><div><small>Visit duration</small><strong>@Model.VisitDurationHours hours</strong></div><div><small>Department</small><strong>@Model.Department.Name</strong></div><div><small>Security department</small><strong>@Model.SecurityDepartment</strong></div></div>
@if (!string.IsNullOrWhiteSpace(Model.DecisionComment)) { <div class="decision-note"><strong>Administrator comments</strong><p>@Model.DecisionComment</p>@if (Model.Status == Endy.Models.RequestStatus.ModificationRequired && ViewBag.CanCreateRequest == true) { <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Update and resubmit</a> }</div> }
@if (ViewBag.CanReview == true && Model.Status == Endy.Models.RequestStatus.PendingReview) { <form method="post" asp-action="Decide" class="decision-form" id="decisionForm"><input type="hidden" name="id" value="@Model.Id"/><label for="reviewComment">Rejection reason or modification details (required for those actions)</label><textarea id="reviewComment" name="comment" maxlength="2000"></textarea><div><button name="status" value="Approved" class="btn btn-success">Approve</button><button name="status" value="ModificationRequired" class="btn btn-warning" onclick="return requireComment()">Request modification</button><button name="status" value="Rejected" class="btn btn-danger" onclick="return requireComment()">Reject</button></div></form> }
</div><div class="form-card"><h3>Request history</h3><p class="muted">Each event includes an immutable snapshot of the submitted information.</p><div class="timeline">
@foreach (var e in Model.History.OrderByDescending(x => x.OccurredAt)) { <div class="timeline-item"><i></i><div><strong>@e.Action</strong><small>@(Endy.Models.DateTimeDisplay.ToLocal(e.OccurredAt).ToString("dd MMM yyyy, HH:mm")) · @e.User</small>@if (!string.IsNullOrWhiteSpace(e.Comment)) { <p>@e.Comment</p> }</div></div> }
</div></div></div>
@section Scripts { <script>function requireComment(){var field=document.getElementById('reviewComment');if(!field.value.trim()){field.setCustomValidity('Enter a reason or modification details.');field.reportValidity();field.addEventListener('input',function(){field.setCustomValidity('');},{once:true});return false;}return true;}</script> }