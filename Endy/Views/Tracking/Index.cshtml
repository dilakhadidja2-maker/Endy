@model IReadOnlyList<Endy.Models.AccessRequest>
@{ ViewData["Title"] = "Customer Tracking"; }
<div class="section-heading"><div><h2>Customer tracking</h2><p class="muted">Record check-in and check-out for approved visitors.</p></div></div>
<div class="table-card"><table class="table enterprise-table"><thead><tr><th>Customer</th><th>Vehicle</th><th>Registration</th><th>Company</th><th>Department</th><th>Check-in</th><th>Duration</th><th>Expected checkout</th><th>Remaining</th><th>Status</th><th></th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="11" class="empty-state">No approved visitors are waiting or checked in.</td></tr> }
@foreach (var r in Model) { var end = r.ExpectedCheckOutTime; <tr data-checkout="@(end?.ToString("O"))"><td><strong>@r.FullName</strong></td><td>@r.VehicleType</td><td>@r.RegistrationNumber</td><td>@r.CompanyName</td><td>@r.Department.Name</td><td>@(r.CheckInTime?.ToLocalTime().ToString("dd MMM, HH:mm") ?? "Not checked in")</td><td>@r.VisitDurationHours hours</td><td>@(end?.ToLocalTime().ToString("dd MMM, HH:mm") ?? "—")</td><td class="countdown">@(r.CheckInTime.HasValue && !r.CheckOutTime.HasValue ? "calculating..." : "—")</td><td><span class="badge-status visit-@r.VisitStatus.ToString().ToLowerInvariant()">@(r.VisitStatus == Endy.Models.VisitStatus.NotCheckedIn ? "Awaiting check-in" : r.VisitStatus.ToString())</span></td><td>@if (ViewBag.IsSecurityUser == true) { if (r.Visit is null) { <form method="post" asp-action="CheckIn"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-primary">Check in</button></form> } else if (!r.CheckOutTime.HasValue) { <form method="post" asp-action="CheckOut"><input type="hidden" name="id" value="@r.Id"/><button class="btn btn-sm btn-light">Check out</button></form> } }</td></tr>}
</tbody></table></div><div class="tracking-note">The visit countdown starts only after Security records check-in and stops at check-out.</div>
@section Scripts { <script>function update(){document.querySelectorAll('[data-checkout]').forEach(function(row){var value=row.dataset.checkout;if(!value)return;var diff=new Date(value)-new Date();var cell=row.querySelector('.countdown');if(diff<=0){cell.textContent='Expired';return;}var h=Math.floor(diff/36e5),m=Math.floor(diff%36e5/6e4);cell.textContent=h+'h '+m+'m';});}update();setInterval(update,30000);</script>}
