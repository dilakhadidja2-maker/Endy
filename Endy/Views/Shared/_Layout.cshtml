<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - DP World Access</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<div class="app-shell">
<aside class="sidebar"><div class="brand"><div class="brand-mark">DP</div><div><strong>DP World</strong><small>Algeria Access</small></div></div><div class="sidebar-label">WORKSPACE</div><nav><a asp-controller="Home" asp-action="Index" class="nav-link"><span>▦</span> Dashboard</a><a asp-controller="Requests" asp-action="Index" class="nav-link"><span>▤</span> Access Requests</a>@if (ViewBag.CanCreateRequest == true) { <a asp-controller="Requests" asp-action="Create" class="nav-link"><span>＋</span> New Request</a> }@if (ViewBag.IsSecurityUser == true || ViewBag.IsAdmin == true) { <a asp-controller="Tracking" asp-action="Index" class="nav-link"><span>◷</span> Customer Tracking</a> }@if (ViewBag.IsAdmin == true) { <a asp-controller="Reports" asp-action="Index" class="nav-link"><span>⌁</span> Reports</a> }@if (ViewBag.IsSuperAdmin == true) { <a asp-controller="Users" asp-action="Index" class="nav-link"><span>♙</span> User Management</a> }<a asp-controller="Notifications" asp-action="Index" class="nav-link"><span>♢</span> Notifications</a></nav><div class="sidebar-footer"><div class="mini-user">@(ViewBag.IsAdmin == true ? "A" : "U")</div><div><strong>@ViewBag.CurrentUser</strong><small>@(ViewBag.IsSuperAdmin == true ? "Super Admin" : ViewBag.IsAdmin == true ? "Administrator" : ViewBag.IsSecurityUser == true ? "Security User" : "Department user")</small></div><form asp-controller="Account" asp-action="Logout" method="post"><button class="logout" aria-label="Sign out">↪</button></form></div></aside>
<main class="main-content"><header class="topbar"><div><span class="eyebrow">ACCESS MANAGEMENT</span><h1>@ViewData["Title"]</h1></div><div class="top-actions"><span class="status-dot"></span><span class="online-label">System operational</span><a asp-controller="Notifications" asp-action="Index" aria-label="Notifications">@await Component.InvokeAsync("NotificationCount")</a><span class="avatar">@(ViewBag.IsAdmin == true ? "A" : "U")</span></div></header><div class="content-wrap">@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> } @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> } @RenderBody()</div></main>
</div><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>