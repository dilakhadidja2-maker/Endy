@model Endy.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; var total = Math.Max(1, Model.TotalRequests); }
<div class="welcome-row"><div><h2>Welcome, @ViewBag.CurrentUser</h2><p class="muted">Access activity overview for your account.</p></div>@if (ViewBag.CanCreateRequest == true) { <a class="btn btn-primary" asp-controller="Requests" asp-action="Create">＋ New access request</a> }</div>
<div class="stats-grid"><div class="stat-card"><span>Total requests</span><strong>@Model.TotalRequests</strong></div><div class="stat-card accent"><span>Pending review</span><strong>@Model.PendingRequests</strong><small>Requires administrator review</small></div><div class="stat-card"><span>Approved</span><strong>@Model.ApprovedRequests</strong></div><div class="stat-card"><span>Rejected</span><strong>@Model.RejectedRequests</strong></div><div class="stat-card"><span>Modification required</span><strong>@Model.ModificationRequired</strong></div><div class="stat-card"><span>Active visitors</span><strong>@Model.ActiveVisitors</strong></div><div class="stat-card"><span>Expired visits</span><strong>@Model.ExpiredVisits</strong></div>@if (Model.TotalDepartments > 0) { <div class="stat-card"><span>Total departments</span><strong>@Model.TotalDepartments</strong></div> }</div>
<div class="section-heading"><div><h3>Recent access requests</h3><p class="muted">Latest requests visible to your account</p></div><a asp-controller="Requests" asp-action="Index">View all requests →</a></div>
<div class="table-card"><table class="table enterprise-table"><thead><tr><th>Customer</th><th>Company</th><th>Department</th><th>Request date</th><th>Status</th><th></th></tr></thead><tbody>
@if (!Model.RecentRequests.Any()) { <tr><td colspan="6" class="empty-state">No access requests to display.</td></tr> }
@foreach (var request in Model.RecentRequests) { <tr><td><strong>@request.FullName</strong><small>@request.RegistrationNumber</small></td><td>@request.CompanyName</td><td>@request.Department.Name</td><td>@(Endy.Models.DateTimeDisplay.ToLocal(request.RequestDate).ToString("dd MMM yyyy, HH:mm"))</td><td><span class="badge-status status-@request.Status.ToString().ToLowerInvariant()">@request.Status.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</span></td><td><a asp-controller="Requests" asp-action="Details" asp-route-id="@request.Id" class="more">View</a></td></tr> }
</tbody></table></div>
<div class="quick-grid"><div class="info-panel"><div class="panel-title"><h3>Request status</h3><span>Current totals</span></div><div class="report-row"><span>Approved</span><b>@Model.ApprovedRequests</b><div class="report-track"><i style="width:@(Model.ApprovedRequests * 100 / total)%"></i></div></div><div class="report-row"><span>Pending review</span><b>@Model.PendingRequests</b><div class="report-track"><i style="width:@(Model.PendingRequests * 100 / total)%"></i></div></div><div class="report-row"><span>Rejected</span><b>@Model.RejectedRequests</b><div class="report-track"><i style="width:@(Model.RejectedRequests * 100 / total)%"></i></div></div><div class="report-row"><span>Modification required</span><b>@Model.ModificationRequired</b><div class="report-track"><i style="width:@(Model.ModificationRequired * 100 / total)%"></i></div></div></div><div class="info-panel"><div class="panel-title"><h3>Visitor monitoring</h3><span>Check-in based</span></div><div class="legend"><span>Active visitors <b>@Model.ActiveVisitors</b></span><span>Expired visits <b>@Model.ExpiredVisits</b></span><span>Active departments <b>@Model.TotalDepartments</b></span></div></div></div>