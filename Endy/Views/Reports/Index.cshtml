@{ ViewData["Title"] = "Reports"; var requests = (IReadOnlyList<Endy.Models.AccessRequest>)ViewBag.Requests; }
<div class="section-heading"><div><h2>Reports & analytics</h2><p class="muted">Filter operational reports and export the results.</p></div><div><button class="btn btn-light" onclick="window.print()">Export PDF</button><a class="btn btn-primary" asp-action="ExportExcel" asp-route-status="@ViewBag.Status" asp-route-departmentId="@ViewBag.DepartmentId" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To">Export Excel (CSV)</a></div></div>
<form class="filter-bar" method="get"><select name="status"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<Endy.Models.RequestStatus>()) { <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</option> }</select><select name="departmentId"><option value="">All departments</option>@foreach (var d in (IReadOnlyList<Endy.Models.Department>)ViewBag.Departments) { <option value="@d.Id" selected="@(ViewBag.DepartmentId?.ToString() == d.Id.ToString())">@d.Name</option> }</select><label>From <input type="date" name="from" value="@ViewBag.From"/></label><label>To <input type="date" name="to" value="@ViewBag.To"/></label><button class="btn btn-outline-secondary">Apply filters</button></form>
<div class="stats-grid"><div class="stat-card"><span>Total requests</span><strong>@requests.Count</strong></div><div class="stat-card"><span>Approved requests</span><strong>@requests.Count(r => r.Status == Endy.Models.RequestStatus.Approved)</strong></div><div class="stat-card"><span>Rejected requests</span><strong>@requests.Count(r => r.Status == Endy.Models.RequestStatus.Rejected)</strong></div><div class="stat-card"><span>Active visitors</span><strong>@requests.Count(r => r.VisitStatus is Endy.Models.VisitStatus.Active or Endy.Models.VisitStatus.ExpiringSoon)</strong></div><div class="stat-card"><span>Expired visits</span><strong>@requests.Count(r => r.VisitStatus == Endy.Models.VisitStatus.Expired)</strong></div><div class="stat-card"><span>Completed visits</span><strong>@requests.Count(r => r.VisitStatus == Endy.Models.VisitStatus.CheckedOut)</strong></div></div>
<div class="table-card"><table class="table enterprise-table"><thead><tr><th>Customer</th><th>Department</th><th>Status</th><th>Request date</th><th>Visit status</th></tr></thead><tbody>
@foreach (var r in requests) { <tr><td><strong>@r.FullName</strong><small>@r.RegistrationNumber</small></td><td>@r.Department.Name</td><td>@r.Status.ToString().Replace("PendingReview", "Pending Review").Replace("ModificationRequired", "Modification Required")</td><td>@(Endy.Models.DateTimeDisplay.ToLocal(r.RequestDate).ToString("dd MMM yyyy"))</td><td>@r.VisitStatus</td></tr> }
</tbody></table></div>