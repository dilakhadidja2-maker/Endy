@model Endy.Models.UserFormInput
<div class="form-grid"><div><label asp-for="FullName"></label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger"></span></div><div><label asp-for="UserName"></label><input asp-for="UserName" class="form-control" autocomplete="username"/><span asp-validation-for="UserName" class="text-danger"></span></div><div><label asp-for="Email"></label><input asp-for="Email" class="form-control"/><span asp-validation-for="Email" class="text-danger"></span></div><div><label asp-for="Role"></label><select asp-for="Role" class="form-select">@foreach (var role in Endy.Models.AppRoles.All) { <option value="@role">@role</option> }</select></div><div><label asp-for="DepartmentId">Department</label><select asp-for="DepartmentId" class="form-select"><option value="">No department</option>@foreach (var department in (IReadOnlyList<Endy.Models.Department>)ViewBag.Departments) { <option value="@department.Id">@department.Name</option> }</select></div>@if (ViewBag.IsCreate == true) { <div><label asp-for="Password">Initial password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div> }</div>
