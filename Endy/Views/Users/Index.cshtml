@model IReadOnlyList<Endy.Models.ApplicationUser>
@{ ViewData["Title"] = "User Management"; }
<div class="section-heading"><div><h2>System users</h2><p class="muted">Manage employee accounts, departments and permissions.</p></div><a class="btn btn-primary" asp-action="Create">＋ Create user</a></div>
<form method="get" class="filter-bar"><input name="search" value="@ViewBag.Search" placeholder="Search name or username"/><select name="role"><option value="">All roles</option>@foreach (var role in Endy.Models.AppRoles.All) { <option value="@role" selected="@(ViewBag.Role?.ToString() == role)">@role</option> }</select><select name="departmentId"><option value="">All departments</option>@foreach (var d in (IReadOnlyList<Endy.Models.Department>)ViewBag.Departments) { <option value="@d.Id" selected="@(ViewBag.DepartmentId?.ToString() == d.Id.ToString())">@d.Name</option> }</select><button class="btn btn-outline-secondary">Filter</button></form>
<div class="table-card"><table class="table enterprise-table"><thead><tr><th>Employee</th><th>Username</th><th>Role</th><th>Department</th><th>Account</th><th></th></tr></thead><tbody>@foreach (var user in Model) { <tr><td><strong>@user.FullName</strong></td><td>@user.UserName</td><td>@ViewBag.UserRoles[user.Id]</td><td>@user.Department?.Name</td><td>@(user.IsActive ? "Active" : "Suspended")</td><td><a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-light">Edit</a></td></tr> }</tbody></table></div>
