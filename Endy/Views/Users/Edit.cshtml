@model Endy.Models.UserFormInput
@{ ViewData["Title"] = "Edit User"; }
<div class="section-heading"><div><h2>Edit employee account</h2><p class="muted">Update account details, access and permissions.</p></div></div><div class="form-card"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input type="hidden" name="id" value="@ViewBag.UserId"/><partial name="_Form" model="Model"/><div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@(ViewBag.IsActive == true)"/><label class="form-check-label">Account active</label></div><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancel</a><button class="btn btn-primary">Save changes</button></div></form><hr/><form method="post" asp-action="ResetPassword"><input type="hidden" name="id" value="@ViewBag.UserId"/><label for="newPassword">Set a temporary password (minimum 12 characters)</label><input id="newPassword" name="newPassword" type="password" class="form-control" minlength="12" required/><button class="btn btn-outline-secondary mt-2">Reset password</button></form></div>
